{erl_opts, [debug_info]}.

{project_plugins, [
    {rebar3_reltree, {path, "."}},
    {rebar3_docker_ci, {git, "https://github.com/slepher/rebar3_docker_ci.git", {tag, "0.5.2"}}}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
{xref_ignores, [
    {rebar_dir, base_dir, 1},
    {rebar_state, add_provider, 2},
    {rebar_state, command_args, 1},
    {rebar_state, current_profiles, 1},
    {rebar_state, dir, 1},
    {rebar_state, get, 3},
    {rebar_state, set, 3},
    {providers, create, 1}
]}.

{docker_ci, [
    {erlang_versions, ["21", "22", "23", "24", "25", "26", "27", "28", "29"]},
    {use_checkouts, false},
    {run_eunit, true}
]}.
